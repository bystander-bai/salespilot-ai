{
  "name": "sales-order-agent",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "apps/api",
    "apps/web",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run build:contracts && concurrently -k \"npm run dev:api\" \"npm run dev:web\"",
    "dev:api": "npm --workspace apps/api run dev",
    "dev:web": "npm --workspace apps/web run dev",
    "build": "npm run build:contracts && npm run build:api && npm run build:web",
    "build:contracts": "npm --workspace packages/contracts run build",
    "build:api": "npm --workspace apps/api run build",
    "build:web": "npm --workspace apps/web run build",
    "db:generate": "npm --workspace apps/api run db:generate",
    "db:migrate": "npm --workspace apps/api run db:migrate",
    "db:seed": "npm --workspace apps/api run db:seed",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "admin:create": "npm run build:contracts && npm --workspace apps/api run admin:create",
    "test": "npm run build:contracts && vitest run",
    "test:e2e": "npm run build:contracts && playwright test",
    "db:backup": "npm --workspace apps/api run db:backup"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/node": "^22.20.5",
    "concurrently": "^9.1.2",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
